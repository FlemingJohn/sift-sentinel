# ---------------------------------------------------------------------------
# SIFT - Sentinel — repository ignore rules
# ---------------------------------------------------------------------------

# --- Large reference / downloaded data (3.6GB, fetch out-of-band) ----------
sift-mcp-servers/repoistory-reference/

# Auto-downloaded IEEE OUI/IAB vendor databases (regenerated by network tools)
*.bak

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Environment / secrets -------------------------------------------------
.env
.env.local
*.local.env
!.env.example

# --- Runtime logs ----------------------------------------------------------
# (note: dataset .jsonl files are intentionally NOT ignored; only log dirs are)
logs/
*.log

# --- Agent investigation outputs (generated per case) ----------------------
reports/

# --- Test / coverage / caches ----------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Misc stray files ------------------------------------------------------
n
