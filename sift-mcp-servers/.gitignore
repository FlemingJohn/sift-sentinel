# sift-mcp-servers — module ignore rules

# Large reference / downloaded data (3.6GB, fetch out-of-band)
repoistory-reference/

# Auto-downloaded IEEE OUI/IAB vendor backups (regenerated by network tools)
*.bak

# Python build / packaging artifacts
build/
dist/
*.egg-info/
*.egg
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Runtime logs
logs/
*.log
