ANTHROPIC_API_KEY=sk-ant-...

# WSL stdio launcher for SIFT-MCP servers
SIFT_USE_WSL=1
SIFT_WSL_DISTRO=Ubuntu-22.04
SIFT_UVX_PATH=/home/youruser/.local/bin/uvx
SIFT_SERVERS_DIR=/mnt/c/Users/FlemingJohn/Downloads/sift-mcp-servers/servers

# Persistence (Postgres recommended; sqlite fallback supported by run.py)
SIFT_PG_URL=postgresql://sift:sift@localhost:5432/sift
SIFT_CHECKPOINT_BACKEND=sqlite
SIFT_SQLITE_PATH=./sift_checkpoints.sqlite

# Model tiers
SIFT_MODEL_SUPERVISOR=claude-opus-4-7
SIFT_MODEL_WORKER=claude-haiku-4-5-20251001
SIFT_MODEL_SYNTH=claude-opus-4-7
