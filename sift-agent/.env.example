# Authentication
# Leave ANTHROPIC_API_KEY unset to run keyless on a Claude subscription login.
# Set it to bill against the Anthropic API instead.
# ANTHROPIC_API_KEY=sk-ant-...

# WSL distribution that hosts the SIFT MCP servers and forensic binaries
SIFT_WSL_DISTRIBUTION=Ubuntu-22.04

# Directory of the MCP server scripts as seen from inside the WSL distribution
SIFT_MCP_SERVERS_DIRECTORY=/mnt/c/Users/FlemingJohn/Downloads/SIFT - Sentinel/sift-mcp-servers/servers

# Model tiers
SIFT_WORKER_MODEL=haiku
SIFT_SUPERVISOR_MODEL=opus

# Output locations relative to the working directory
SIFT_REPORTS_DIRECTORY=./reports
SIFT_AUDIT_LOG_DIRECTORY=./logs

# Per-specialist guardrails
SIFT_MAXIMUM_TURNS_PER_SPECIALIST=25
SIFT_MAXIMUM_BUDGET_USD=5.0
